{
  "compilerOptions": {
    "module": "node16",
    "moduleResolution": "node16",
    "noImplicitReturns": true,
    "noImplicitAny": false,
    "noUnusedLocals": true,
    "outDir": "lib",
    "sourceMap": true,
    "strict": false,
    "skipLibCheck": true,
    "target": "es2021"
  },
  "compileOnSave": true,
  "include": ["src"]
}
