rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // ==========================================
    // SECURITY AUTHENTICATION HELPERS
    // ==========================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token != null && request.auth.token.email_verified == true;
    }

    function isSuperAdminEmail() {
      return isEmailVerified() && request.auth.token.email in ['koreanskinfood.bd@gmail.com', 'admin@koreanskinfood.bd'];
    }

    // Helper to check if user has a verified staff role (super_admin, admin, inventory_manager, hr, customer_support)
    function isStaff() {
      return isSignedIn() && (
        isSuperAdminEmail() ||
        (isEmailVerified() && request.auth.token.email in ['inventory@koreanskinfood.bd']) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in [
           'admin', 'inventory_manager', 'super_admin', 'hr', 'customer_support'
         ])
      );
    }

    // Helper to check if user is admin or super_admin
    function isAdminOrSuperAdmin() {
      return isSignedIn() && (
        isSuperAdminEmail() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super_admin'])
      );
    }

    // Helper to check if user is inventory_manager or admin/super_admin
    function isInventoryManagerOrAdmin() {
      return isStaff() && (
        isAdminOrSuperAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'inventory_manager')
      );
    }

    // ==========================================
    // CORE USER PROFILES & PII PROTECTION
    // ==========================================

    match /users/{userId} {
      // PII Isolation: Only staff or the account owner can read user profiles
      allow read: if isStaff() || (isSignedIn() && request.auth.uid == userId);

      // Create: Staff or self-registration with non-privileged roles and zeroed balances
      allow create: if isStaff() || (
        isSignedIn() && 
        request.auth.uid == userId && 
        (!('role' in request.resource.data) || request.resource.data.role in ['customer', 'creator']) &&
        (!('wholesaleAccess' in request.resource.data) || request.resource.data.wholesaleAccess == false) &&
        (!('creditLimit' in request.resource.data) || request.resource.data.creditLimit == 0) &&
        (!('currentDue' in request.resource.data) || request.resource.data.currentDue == 0) &&
        (!('permissions' in request.resource.data) || request.resource.data.permissions.size() == 0)
      );

      // Update: Staff can edit all fields; users cannot escalate privileges or modify financials
      allow update: if isStaff() || (
        isSignedIn() && 
        request.auth.uid == userId && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'wholesaleAccess', 'creditLimit', 'currentDue', 'permissions', 'status'
        ])
      );

      allow delete: if isStaff();
    }

    // ==========================================
    // CREATOR NETWORK & AFFILIATES
    // ==========================================

    // public_creators - Public Read, Staff Write, Creator self-write with protected sensitive fields
    match /public_creators/{creatorId} {
      allow read: if true;
      allow create: if isStaff() || (
        isSignedIn() && (request.auth.uid == creatorId || request.auth.uid == request.resource.data.creatorId)
      );
      allow update: if isStaff() || (
        isSignedIn() && 
        (resource != null && (resource.data.userId == request.auth.uid || request.auth.uid == creatorId)) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'status', 'totalPoints', 'level', 'levelProgress', 'totalViews', 'totalLikes', 'totalComments', 'totalReels'
        ])
      );
      allow delete: if isStaff();
    }

    // creators - Internal application and management
    match /creators/{creatorId} {
      allow read: if isStaff() || (
        isSignedIn() && (
          request.auth.uid == creatorId ||
          (resource != null && resource.data.userId == request.auth.uid)
        )
      );
      allow create: if isStaff() || (
        isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.role == 'creator' &&
        request.resource.data.totalPoints == 0 &&
        request.resource.data.totalReels == 0 &&
        request.resource.data.totalViews == 0 &&
        request.resource.data.totalLikes == 0 &&
        request.resource.data.totalComments == 0 &&
        request.resource.data.level == 1 &&
        request.resource.data.levelProgress == 0
      );
      allow update: if isStaff() || (
        isSignedIn() &&
        resource.data.userId == request.auth.uid &&
        resource.data.status != 'suspended' &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.level == resource.data.level &&
        request.resource.data.levelName == resource.data.levelName &&
        request.resource.data.levelProgress == resource.data.levelProgress &&
        request.resource.data.totalPoints == resource.data.totalPoints &&
        request.resource.data.totalViews == resource.data.totalViews &&
        request.resource.data.totalLikes == resource.data.totalLikes &&
        request.resource.data.totalComments == resource.data.totalComments &&
        request.resource.data.totalReels == resource.data.totalReels &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'username', 'profileImage', 'bio', 'phone', 'facebookUrl', 'instagramUrl', 'niche', 'shippingAddress', 'socialLinks', 'updatedAt'
        ])
      );
      allow delete: if isStaff();
    }

    // creator_reels - Creator video posts and performance
    match /creator_reels/{reelId} {
      allow read: if isStaff() || (
        resource != null && (
          resource.data.status == 'approved' ||
          (isSignedIn() && (resource.data.creatorUserId == request.auth.uid || resource.data.userId == request.auth.uid))
        )
      );
      allow create: if isStaff() || (
        isSignedIn() && 
        (request.resource.data.creatorUserId == request.auth.uid || request.resource.data.userId == request.auth.uid) &&
        (!('status' in request.resource.data) || request.resource.data.status in ['pending', 'processing']) &&
        (!('earnedPoints' in request.resource.data) || request.resource.data.earnedPoints == 0)
      );
      allow update: if isStaff() || (
        isSignedIn() && 
        (resource.data.creatorUserId == request.auth.uid || resource.data.userId == request.auth.uid) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'status', 'earnedPoints', 'verifiedMetrics', 'rejectionReason', 'reviewedBy', 'reviewedAt'
        ])
      );
      allow delete: if isStaff();
    }

    // ==========================================
    // CATALOG & STORE TAXONOMY (STAFF ONLY WRITES)
    // ==========================================

    match /products/{productId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /taxonomies/{taxonomyId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /brands/{brandId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // ==========================================
    // ORDERS & COMMERCE TRANSACTIONS
    // ==========================================

    match /orders/{orderId} {
      allow read: if isStaff() || (
        isSignedIn() && (
          resource == null ||
          resource.data.customer_uid == request.auth.uid ||
          resource.data.customerId == request.auth.uid ||
          resource.data.userId == request.auth.uid ||
          (resource.data.customerEmail != null && resource.data.customerEmail == request.auth.token.email)
        )
      );
      allow create: if true; // Allows retail online & POS guest checkout
      allow update: if isStaff() || (
        isSignedIn() && 
        (resource.data.customer_uid == request.auth.uid || resource.data.userId == request.auth.uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['customerNotes', 'updatedAt'])
      );
      allow delete: if isStaff();
    }

    match /draft_orders/{draftId} {
      allow read, write: if isStaff();
    }

    match /product_reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isStaff();
    }

    match /chat_leads/{leadId} {
      allow create: if true;
      allow read, update, delete: if isStaff();
    }

    // ==========================================
    // INVENTORY, FINANCIAL & AUDIT LEDGERS
    // ==========================================

    match /inventory_logs/{logId} {
      allow read, write: if isStaff();
    }
    match /stock_movements/{movementId} {
      allow read, write: if isStaff();
    }
    match /stock_receipts/{receiptId} {
      allow read, write: if isStaff();
    }
    match /inventory_cost_layers/{layerId} {
      allow read, write: if isStaff();
    }
    match /ad_performance/{perfId} {
      allow read, write: if isStaff();
    }
    match /agent_runs/{runId} {
      allow read, write: if isStaff();
    }
    match /ai_agent_runs/{runId} {
      allow read, write: if isStaff();
    }
    match /site_settings/{settingId} {
      allow read: if true;
      allow write: if isStaff();
    }
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isStaff();
    }
    match /reel_metric_audits/{auditId} {
      allow read, write: if isStaff();
    }
    match /cloudinary_images/{imageId} {
      allow read: if true;
      allow write: if isStaff();
    }
    match /slack_users/{slackUserId} {
      allow read, write: if isStaff();
    }
    match /slack_error_logs/{logId} {
      allow read, write: if isStaff();
    }
    match /product_imports/{importId} {
      allow read, write: if isStaff();
    }
    match /audit_logs/{logId} {
      allow read, write: if isStaff();
    }
    match /support_tickets/{ticketId} {
      allow read: if isStaff() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if true;
      allow update, delete: if isStaff();
    }
    match /pos_sessions/{sessionId} {
      allow read, write: if isStaff();
      match /scans/{scanId} {
        allow read, write: if isStaff();
      }
    }
    match /admin_notifications/{notificationId} {
      allow read, write: if isStaff();
    }
    match /payment_idempotency/{keyId} {
      allow read, write: if isStaff();
    }
    match /payment_transactions/{txId} {
      allow read, write: if isStaff();
    }
    match /financial_transactions/{txId} {
      allow read, write: if isStaff();
    }

    // ==========================================
    // WHOLESALE COMMERCE SECURITY
    // ==========================================

    match /wholesale_customers/{customerId} {
      allow read: if isStaff() || (
        isSignedIn() && (
          request.auth.uid == customerId || 
          (resource != null && (resource.data.userId == request.auth.uid || resource.data.id == request.auth.uid))
        )
      );
      allow write: if isStaff();
    }

    match /wholesale_payments/{paymentId} {
      allow read: if isStaff() || (
        isSignedIn() && resource != null && (
          resource.data.wholesaleCustomerId == request.auth.uid || 
          resource.data.userId == request.auth.uid
        )
      );
      allow write: if isStaff();
    }

    match /wholesale_orders/{orderId} {
      allow read: if isStaff() || (
        isSignedIn() && (
          resource == null || 
          resource.data.userId == request.auth.uid || 
          resource.data.customerId == request.auth.uid ||
          resource.data.wholesaleCustomerId == request.auth.uid
        )
      );
      allow create: if isStaff() || (isSignedIn() && request.resource.data.userId == request.auth.uid);
      allow update, delete: if isStaff();
    }

    // ==========================================
    // FCM NOTIFICATIONS & COUPONS
    // ==========================================

    match /fcm_tokens/{tokenId} {
      allow read: if isStaff() || (isSignedIn() && resource != null && resource.data.userId == request.auth.uid);
      allow create, update: if true;
      allow delete: if isStaff() || (isSignedIn() && resource != null && resource.data.userId == request.auth.uid);
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow create, delete: if isStaff();
      allow update: if isStaff() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usageCount', 'updatedAt'])
      );
    }
  }
}
