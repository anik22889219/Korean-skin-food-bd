rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper to check if user has a staff role
    function isStaff() {
      return request.auth != null && (
        (request.auth.token != null && 'email' in request.auth.token && request.auth.token.email in ['koreanskinfood.bd@gmail.com', 'admin@koreanskinfood.bd', 'inventory@koreanskinfood.bd']) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'inventory_manager', 'customer_support', 'super_admin', 'hr'])
      );
    }

    // Helper to check if user is admin or super_admin (excluding inventory_manager and other staff)
    function isAdminOrSuperAdmin() {
      return request.auth != null && (
        (request.auth.token != null && 'email' in request.auth.token && request.auth.token.email in ['koreanskinfood.bd@gmail.com', 'admin@koreanskinfood.bd']) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super_admin'])
      );
    }

    // users
    match /users/{userId} {
      allow read: if isStaff() || (request.auth != null && request.auth.uid == userId);
      allow create: if isStaff() || (
        request.auth != null && 
        request.auth.uid == userId && 
        (!('role' in request.resource.data) || request.resource.data.role in ['customer', 'creator']) &&
        (!('wholesaleAccess' in request.resource.data) || request.resource.data.wholesaleAccess == false)
      );
      allow update: if isStaff() || (
        request.auth != null && 
        request.auth.uid == userId && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'wholesaleAccess'])
      );
      allow delete: if isStaff() || (request.auth != null && request.auth.uid == userId);
    }

    // public_creators (Public read-safe collection for leaderboard, containing NO private personal info)
    match /public_creators/{creatorId} {
      allow read: if true;
      allow write: if isStaff() || (
        request.auth != null && (request.auth.uid == creatorId || request.auth.uid == request.resource.data.creatorId)
      );
    }

    // creators (Private Creator Profile - only visible to staff or the creator themselves)
    match /creators/{creatorId} {
      allow read: if isStaff() || (
        request.auth != null && (
          request.auth.uid == creatorId ||
          (resource != null && resource.data.userId == request.auth.uid)
        )
      );

      allow create: if isStaff() || (
        request.auth != null &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.role == 'creator' &&
        request.resource.data.totalPoints == 0 &&
        request.resource.data.totalReels == 0 &&
        request.resource.data.totalViews == 0 &&
        request.resource.data.totalLikes == 0 &&
        request.resource.data.totalComments == 0 &&
        request.resource.data.level == 1 &&
        request.resource.data.levelProgress == 0
      );

      // Creator can only update non-sensitive personal fields.
      // Modifying points, views, likes, comments, level, levelProgress, status, or role is strictly forbidden for creators.
      allow update: if isStaff() || (
        request.auth != null &&
        resource.data.userId == request.auth.uid &&
        resource.data.status != 'suspended' &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.level == resource.data.level &&
        request.resource.data.levelName == resource.data.levelName &&
        request.resource.data.levelProgress == resource.data.levelProgress &&
        request.resource.data.totalPoints == resource.data.totalPoints &&
        request.resource.data.totalViews == resource.data.totalViews &&
        request.resource.data.totalLikes == resource.data.totalLikes &&
        request.resource.data.totalComments == resource.data.totalComments &&
        request.resource.data.totalReels == resource.data.totalReels &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'username', 'profileImage', 'bio', 'phone', 'facebookUrl', 'instagramUrl', 'niche', 'shippingAddress', 'socialLinks', 'updatedAt'
        ])
      );

      allow delete: if isStaff();
    }

    // creator_reels
    match /creator_reels/{creatorReelId} {
      allow read: if isStaff() || (
        // Public can read approved/published reels, creators can read their own submissions
        resource.data.status in ['approved', 'published'] ||
        (request.auth != null && (resource.data.creatorUserId == request.auth.uid || resource.data.creatorId == request.auth.uid))
      );

      allow create: if isStaff() || (
        request.auth != null &&
        request.resource.data.creatorUserId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.performance.views == 0 &&
        request.resource.data.performance.likes == 0 &&
        request.resource.data.performance.comments == 0 &&
        request.resource.data.performance.points == 0 &&
        get(/databases/$(database)/documents/creators/$(request.auth.uid)).data.status == 'approved'
      );

      // Creator cannot approve themselves or alter performance metrics/points
      allow update: if isStaff() || (
        request.auth != null &&
        resource.data.creatorUserId == request.auth.uid &&
        get(/databases/$(database)/documents/creators/$(request.auth.uid)).data.status == 'approved' &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.performance == resource.data.performance &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'caption', 'tags', 'updatedAt', 'videoUrl', 'thumbnailUrl', 'description', 'facebookPostUrl', 'productIds', 'productNames',
          'cloudinaryPublicId', 'secureUrl', 'resourceType', 'duration', 'width', 'height', 'videoMetadata'
        ])
      );

      allow delete: if isStaff() || (
        request.auth != null &&
        resource.data.creatorUserId == request.auth.uid &&
        resource.data.status in ['pending', 'rejected']
      );
    }

    // products
    match /products/{productId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // orders
    match /orders/{orderId} {
      allow create: if true;
      allow read: if isStaff() || (request.auth != null && resource.data.customer_uid == request.auth.uid);
      allow update, delete: if isStaff();
    }

    // product_reviews
    match /product_reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if isStaff();
    }

    // chat_leads
    match /chat_leads/{leadId} {
      allow create: if true;
      allow read, update, delete: if isStaff();
    }

    // Staff-only collections
    match /inventory_logs/{logId} {
      allow read, write: if isStaff();
    }

    match /ad_performance/{perfId} {
      allow read, write: if isStaff();
    }

    match /agent_runs/{runId} {
      allow read, write: if isStaff();
    }

    match /ai_agent_runs/{runId} {
      allow read, write: if isStaff();
    }

    match /site_settings/{settingId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /reel_metric_audits/{auditId} {
      allow read, write: if isStaff();
    }

    match /draft_orders/{draftId} {
      allow read, write: if isStaff();
    }

    match /cloudinary_images/{imageId} {
      allow read, write: if isStaff();
    }

    match /stock_movements/{movementId} {
      allow read, write: if isStaff();
    }

    match /stock_receipts/{receiptId} {
      allow read, write: if isStaff();
    }

    match /slack_users/{slackUserId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /product_imports/{importId} {
      allow create: if true;
      allow read, update, delete: if isStaff();
    }

    match /audit_logs/{logId} {
      allow create: if true;
      allow read, update, delete: if isStaff();
    }

    match /support_tickets/{ticketId} {
      allow create: if true;
      allow read: if isStaff() || (request.auth != null && resource.data.customerEmail == request.auth.token.email);
      allow update, delete: if isStaff();
    }

    match /slack_error_logs/{logId} {
      allow create: if true;
      allow read, update, delete: if isStaff();
    }

    match /pos_sessions/{sessionId} {
      allow read, write: if true;

      match /scans/{scanId} {
        allow read, write: if true;
      }
    }

    // admin_notifications (Only admin and super_admin can read, staff can create on new session start)
    match /admin_notifications/{notificationId} {
      allow read: if isAdminOrSuperAdmin();
      allow create: if isStaff();
      allow update, delete: if isAdminOrSuperAdmin();
    }
  }
}
