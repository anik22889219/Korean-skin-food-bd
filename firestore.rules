rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper to check if user has a staff role (super_admin, admin, inventory_manager, hr)
    function isStaff() {
      return request.auth != null && (
        (request.auth.token != null && 'email' in request.auth.token && request.auth.token.email in ['koreanskinfood.bd@gmail.com', 'admin@koreanskinfood.bd', 'inventory@koreanskinfood.bd']) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'inventory_manager', 'super_admin', 'hr'])
      );
    }

    // Helper to check if user is admin or super_admin
    function isAdminOrSuperAdmin() {
      return request.auth != null && (
        (request.auth.token != null && 'email' in request.auth.token && request.auth.token.email in ['koreanskinfood.bd@gmail.com', 'admin@koreanskinfood.bd']) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super_admin'])
      );
    }

    // Helper to check if user is inventory_manager or admin/super_admin
    function isInventoryManagerOrAdmin() {
      return isStaff() && (
        isAdminOrSuperAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'inventory_manager')
      );
    }

    // users
    match /users/{userId} {
      allow read: if isStaff() || (request.auth != null && request.auth.uid == userId);
      allow create: if isStaff() || (
        request.auth != null && 
        request.auth.uid == userId && 
        (!('role' in request.resource.data) || request.resource.data.role in ['customer', 'creator']) &&
        (!('wholesaleAccess' in request.resource.data) || request.resource.data.wholesaleAccess == false) &&
        (!('creditLimit' in request.resource.data) || request.resource.data.creditLimit == 0) &&
        (!('currentDue' in request.resource.data) || request.resource.data.currentDue == 0) &&
        (!('permissions' in request.resource.data) || request.resource.data.permissions.size() == 0)
      );
      allow update: if isStaff() || (
        request.auth != null && 
        request.auth.uid == userId && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'wholesaleAccess', 'creditLimit', 'currentDue', 'permissions', 'status'])
      );
      allow delete: if isStaff() || (request.auth != null && request.auth.uid == userId);
    }

    // public_creators
    match /public_creators/{creatorId} {
      allow read: if true;
      allow write: if isStaff() || (
        request.auth != null && (request.auth.uid == creatorId || request.auth.uid == request.resource.data.creatorId)
      );
    }

    // creators
    match /creators/{creatorId} {
      allow read: if isStaff() || (
        request.auth != null && (
          request.auth.uid == creatorId ||
          (resource != null && resource.data.userId == request.auth.uid)
        )
      );
      allow create: if isStaff() || (
        request.auth != null &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.role == 'creator' &&
        request.resource.data.totalPoints == 0 &&
        request.resource.data.totalReels == 0 &&
        request.resource.data.totalViews == 0 &&
        request.resource.data.totalLikes == 0 &&
        request.resource.data.totalComments == 0 &&
        request.resource.data.level == 1 &&
        request.resource.data.levelProgress == 0
      );
      allow update: if isStaff() || (
        request.auth != null &&
        resource.data.userId == request.auth.uid &&
        resource.data.status != 'suspended' &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.level == resource.data.level &&
        request.resource.data.levelName == resource.data.levelName &&
        request.resource.data.levelProgress == resource.data.levelProgress &&
        request.resource.data.totalPoints == resource.data.totalPoints &&
        request.resource.data.totalViews == resource.data.totalViews &&
        request.resource.data.totalLikes == resource.data.totalLikes &&
        request.resource.data.totalComments == resource.data.totalComments &&
        request.resource.data.totalReels == resource.data.totalReels &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'username', 'profileImage', 'bio', 'phone', 'facebookUrl', 'instagramUrl', 'niche', 'shippingAddress', 'socialLinks', 'updatedAt'
        ])
      );
      allow delete: if isStaff();
    }

    // products - Public Read, Staff Write
    match /products/{productId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // orders - Secured: customer reads/creates own orders, updates safe fields, staff manages all
    match /orders/{orderId} {
      allow read: if isStaff() || (
        request.auth != null && (
          (resource != null && (resource.data.customerId == request.auth.uid || resource.data.userId == request.auth.uid || resource.data.customerEmail == request.auth.token.email)) ||
          (request.resource != null && (request.resource.data.customerId == request.auth.uid || request.resource.data.userId == request.auth.uid))
        )
      );
      allow create: if isStaff() || (
        request.auth != null && (
          request.resource.data.customerId == request.auth.uid || 
          request.resource.data.userId == request.auth.uid ||
          request.resource.data.customerEmail == request.auth.token.email
        ) &&
        (!('paymentStatus' in request.resource.data) || request.resource.data.paymentStatus in ['pending', 'unpaid']) &&
        (!('orderStatus' in request.resource.data) || request.resource.data.orderStatus in ['pending', 'placed'])
      );
      allow update: if isStaff() || (
        request.auth != null && 
        resource != null && 
        (resource.data.customerId == request.auth.uid || resource.data.userId == request.auth.uid) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'totalAmount', 'total', 'paymentStatus', 'orderStatus', 'status', 'assignedStaff', 'internalNotes', 'importCost', 'cogs', 'profit', 'shippingInternal', 'deliveryInternal'
        ])
      );
      allow delete: if isAdminOrSuperAdmin();
    }

    // product_reviews
    match /product_reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if isStaff();
    }

    // chat_leads
    match /chat_leads/{leadId} {
      allow create: if true;
      allow read, update, delete: if isStaff();
    }

    // Protected Staff Collections (Inventory, Logs, POS, Finance, Wholesale, etc.)
    match /inventory_logs/{logId} {
      allow read, write: if isStaff();
    }
    match /ad_performance/{perfId} {
      allow read, write: if isStaff();
    }
    match /agent_runs/{runId} {
      allow read, write: if isStaff();
    }
    match /ai_agent_runs/{runId} {
      allow read, write: if isStaff();
    }
    match /site_settings/{settingId} {
      allow read: if true;
      allow write: if isStaff();
    }
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isStaff();
    }
    match /reel_metric_audits/{auditId} {
      allow read, write: if isStaff();
    }
    match /draft_orders/{draftId} {
      allow read, write: if request.auth != null;
    }
    match /cloudinary_images/{imageId} {
      allow read, write: if isStaff();
    }
    match /stock_movements/{movementId} {
      allow read, write: if isInventoryManagerOrAdmin();
    }
    match /stock_receipts/{receiptId} {
      allow read, write: if isInventoryManagerOrAdmin();
    }
    match /slack_users/{slackUserId} {
      allow read: if true;
      allow write: if isStaff();
    }
    match /product_imports/{importId} {
      allow create: if request.auth != null;
      allow read, update, delete: if isStaff();
    }
    match /audit_logs/{logId} {
      allow read: if isStaff();
      allow create: if request.auth != null;
      allow update, delete: if isAdminOrSuperAdmin();
    }
    match /support_tickets/{ticketId} {
      allow create: if request.auth != null;
      allow read: if isStaff() || (request.auth != null && resource != null && resource.data.customerEmail == request.auth.token.email);
      allow update, delete: if isStaff();
    }
    match /slack_error_logs/{logId} {
      allow create: if true;
      allow read, update, delete: if isStaff();
    }
    match /pos_sessions/{sessionId} {
      allow read, write: if isStaff();
      match /scans/{scanId} {
        allow read, write: if isStaff();
      }
    }
    match /admin_notifications/{notificationId} {
      allow read, write: if isStaff();
    }
    match /payment_idempotency/{keyId} {
      allow read, write: if isStaff();
    }
    match /payment_transactions/{txId} {
      allow read, write: if isStaff();
    }
    match /financial_transactions/{txId} {
      allow read, write: if isStaff();
    }
    match /inventory_cost_layers/{layerId} {
      allow read, write: if isInventoryManagerOrAdmin();
    }

    // ==========================================
    // WHOLESALE SECURITY RULES (Least Privilege)
    // ==========================================

    match /wholesale_customers/{customerId} {
      allow read: if isStaff() || (request.auth != null && request.auth.uid == customerId);
      allow create: if isStaff() || (
        request.auth != null && 
        request.auth.uid == customerId && 
        (!('wholesaleAccess' in request.resource.data) || request.resource.data.wholesaleAccess == false) &&
        (!('creditLimit' in request.resource.data) || request.resource.data.creditLimit == 0) &&
        (!('currentDue' in request.resource.data) || request.resource.data.currentDue == 0)
      );
      allow update: if isStaff() || (
        request.auth != null && 
        request.auth.uid == customerId && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['wholesaleAccess', 'creditLimit', 'currentDue', 'status', 'approvalStatus', 'role'])
      );
      allow delete: if isStaff();
    }

    match /wholesale_payments/{paymentId} {
      allow read: if isStaff() || (request.auth != null && resource != null && resource.data.customerId == request.auth.uid);
      allow write: if isStaff();
    }

    match /wholesale_orders/{orderId} {
      allow read: if isStaff() || (
        request.auth != null && resource != null && 
        (resource.data.customerId == request.auth.uid || resource.data.userId == request.auth.uid)
      );
      allow create: if isStaff() || (
        request.auth != null && 
        (request.resource.data.customerId == request.auth.uid || request.resource.data.userId == request.auth.uid)
      );
      allow update: if isStaff() || (
        request.auth != null && 
        resource != null && 
        (resource.data.customerId == request.auth.uid || resource.data.userId == request.auth.uid) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'totalAmount', 'paymentStatus', 'orderStatus', 'status', 'creditLimit', 'dueAmount'
        ])
      );
      allow delete: if isStaff();
    }
  }
}
