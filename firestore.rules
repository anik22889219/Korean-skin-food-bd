rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global helper: Check if user is Super Admin
    function isSuperAdmin() {
      return request.auth != null && (
        (request.auth.token != null && 'email' in request.auth.token && request.auth.token.email == 'koreanskinfood.bd@gmail.com') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin')
      );
    }

    // Global helper: Check if user is Business Admin or Super Admin
    function isAdmin() {
      return request.auth != null && (
        isSuperAdmin() ||
        (request.auth.token != null && 'email' in request.auth.token && request.auth.token.email in ['admin@koreanskinfood.bd', 'koreanskinfood.bd@gmail.com']) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super_admin'])
      );
    }

    // Global helper: Check if user is Inventory Manager
    function isInventoryManager() {
      return request.auth != null && (
        (request.auth.token != null && 'email' in request.auth.token && request.auth.token.email == 'inventory@koreanskinfood.bd') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'inventory_manager')
      );
    }

    // Global helper: Check if user is Customer Support
    function isCustomerSupport() {
      return request.auth != null && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'customer_support'
      );
    }

    // Global helper: Check if user is HR
    function isHR() {
      return request.auth != null && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'hr'
      );
    }

    // Global helper: Staff handling products and inventory
    function isInventoryStaff() {
      return isAdmin() || isInventoryManager();
    }

    // Global helper: Any verified staff member with operational access
    function isStaff() {
      return isAdmin() || isInventoryManager() || isCustomerSupport();
    }

    // ====================================================
    // USER PROFILES & ACCESS
    // ====================================================
    match /users/{userId} {
      // Super admins can view all accounts; users can view their own profile
      allow read: if isSuperAdmin() || (request.auth != null && request.auth.uid == userId);
      
      // Users can register themselves as customer or creator (never admin/staff)
      allow create: if isSuperAdmin() || (
        request.auth != null && 
        request.auth.uid == userId && 
        (!('role' in request.resource.data) || request.resource.data.role in ['customer', 'creator']) &&
        (!('wholesaleAccess' in request.resource.data) || request.resource.data.wholesaleAccess == false)
      );
      
      // Super admin can edit any user profile; regular user can edit profile info, but CANNOT elevate role, wholesaleAccess, or status
      allow update: if isSuperAdmin() || (
        request.auth != null && 
        request.auth.uid == userId && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'wholesaleAccess', 'status'])
      );
      
      // Only super admins can permanently delete user records
      allow delete: if isSuperAdmin();
    }

    // ====================================================
    // FINANCIAL LEDGER & BUSINESS BANKING (ADMIN ONLY)
    // ====================================================
    match /financial_transactions/{txId} {
      allow read: if isAdmin();
      allow create: if isSuperAdmin() || (
        isAdmin() && 
        !(request.resource.data.category in ['OWNER_EQUITY', 'CAPITAL_IN', 'WITHDRAWAL', 'CAPITAL_OUT'])
      );
      allow update: if false; // Immutable financial ledger
      allow delete: if isSuperAdmin(); // Highly restricted
    }

    match /finance_wallets/{walletId} {
      allow read, create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    match /finance_ledger/{ledgerId} {
      allow read, create: if isAdmin();
      allow update: if false; // Immutable ledger
      allow delete: if isSuperAdmin();
    }

    match /business_expenses/{expenseId} {
      allow read, create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    match /capital_transactions/{capId} {
      allow read, create, update, delete: if isSuperAdmin();
    }

    match /payment_transactions/{txId} {
      // Payment transactions readable by admins and customers for their own orders
      allow read: if isAdmin() || (
        request.auth != null && (
          resource.data.customer_uid == request.auth.uid ||
          resource.data.customerEmail == request.auth.token.email
        )
      );
      allow create: if isInventoryStaff() || request.auth != null || true; // Website checkout or POS cashier
      allow update: if false; // Immutable payment history
      allow delete: if false; // Immutable payment history
    }

    match /payment_idempotency/{keyId} {
      allow read, write: if isStaff() || true;
    }

    match /customer_dues/{dueId} {
      allow read: if isAdmin() || (
        request.auth != null && (
          resource.data.customerId == request.auth.uid ||
          resource.data.customer_uid == request.auth.uid ||
          resource.data.customerEmail == request.auth.token.email
        )
      );
      allow write: if isAdmin();
    }

    match /wholesale_customers/{customerId} {
      allow read: if isAdmin() || (
        request.auth != null && (
          request.auth.uid == customerId ||
          (resource != null && resource.data.email == request.auth.token.email)
        )
      );
      allow write: if isAdmin();
    }

    match /inventory_cost_layers/{layerId} {
      allow read, write: if isInventoryStaff();
    }

    // ====================================================
    // PRODUCTS, INVENTORY & CATALOG
    // ====================================================
    match /products/{productId} {
      allow read: if true; // Public catalog
      allow write: if isInventoryStaff();
    }

    match /stock_movements/{movementId} {
      allow read, write: if isInventoryStaff();
    }

    match /stock_receipts/{receiptId} {
      allow read, write: if isInventoryStaff();
    }

    match /inventory_logs/{logId} {
      allow read, write: if isInventoryStaff();
    }

    match /product_imports/{importId} {
      allow create: if isInventoryStaff();
      allow read, update, delete: if isInventoryStaff();
    }

    match /cloudinary_images/{imageId} {
      allow read: if true;
      allow write: if isInventoryStaff();
    }

    // ====================================================
    // ORDERS & FULFILLMENT
    // ====================================================
    match /orders/{orderId} {
      allow create: if true; // Customer online checkout, POS checkout
      allow read: if isStaff() || (
        request.auth != null && (
          resource.data.customer_uid == request.auth.uid ||
          (resource.data.customerEmail != null && resource.data.customerEmail == request.auth.token.email)
        )
      );
      allow update: if isStaff() || (
        request.auth != null && 
        resource.data.customer_uid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cancelReason', 'status']) &&
        request.resource.data.status == 'cancelled' &&
        resource.data.status == 'pending'
      );
      allow delete: if isAdmin();
    }

    match /draft_orders/{draftId} {
      allow read, write: if isStaff();
    }

    // ====================================================
    // POS SESSIONS & REAL-TIME CART SCANNING
    // ====================================================
    match /pos_sessions/{sessionId} {
      allow read, write: if isInventoryStaff();

      match /scans/{scanId} {
        allow read, write: if true; // Mobile scanner camera sync
      }
    }

    match /admin_notifications/{notificationId} {
      allow read: if isAdmin();
      allow create: if isInventoryStaff();
      allow update, delete: if isAdmin();
    }

    // ====================================================
    // CREATOR PROGRAM & REELS
    // ====================================================
    match /public_creators/{creatorId} {
      allow read: if true; // Public leaderboard
      allow write: if isAdmin() || (
        request.auth != null && (request.auth.uid == creatorId || request.auth.uid == request.resource.data.creatorId)
      );
    }

    match /creators/{creatorId} {
      allow read: if isAdmin() || (
        request.auth != null && (
          request.auth.uid == creatorId ||
          (resource != null && resource.data.userId == request.auth.uid)
        )
      );

      allow create: if isAdmin() || (
        request.auth != null &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.role == 'creator' &&
        request.resource.data.totalPoints == 0 &&
        request.resource.data.totalReels == 0 &&
        request.resource.data.totalViews == 0 &&
        request.resource.data.totalLikes == 0 &&
        request.resource.data.totalComments == 0 &&
        request.resource.data.level == 1 &&
        request.resource.data.levelProgress == 0
      );

      allow update: if isAdmin() || (
        request.auth != null &&
        resource.data.userId == request.auth.uid &&
        resource.data.status != 'suspended' &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.level == resource.data.level &&
        request.resource.data.levelName == resource.data.levelName &&
        request.resource.data.levelProgress == resource.data.levelProgress &&
        request.resource.data.totalPoints == resource.data.totalPoints &&
        request.resource.data.totalViews == resource.data.totalViews &&
        request.resource.data.totalLikes == resource.data.totalLikes &&
        request.resource.data.totalComments == resource.data.totalComments &&
        request.resource.data.totalReels == resource.data.totalReels &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'username', 'profileImage', 'bio', 'phone', 'facebookUrl', 'instagramUrl', 'niche', 'shippingAddress', 'socialLinks', 'updatedAt'
        ])
      );

      allow delete: if isAdmin();
    }

    match /creator_reels/{creatorReelId} {
      allow read: if isAdmin() || (
        resource.data.status in ['approved', 'published'] ||
        (request.auth != null && (resource.data.creatorUserId == request.auth.uid || resource.data.creatorId == request.auth.uid))
      );

      allow create: if isAdmin() || (
        request.auth != null &&
        request.resource.data.creatorUserId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.performance.views == 0 &&
        request.resource.data.performance.likes == 0 &&
        request.resource.data.performance.comments == 0 &&
        request.resource.data.performance.points == 0 &&
        get(/databases/$(database)/documents/creators/$(request.auth.uid)).data.status == 'approved'
      );

      allow update: if isAdmin() || (
        request.auth != null &&
        resource.data.creatorUserId == request.auth.uid &&
        get(/databases/$(database)/documents/creators/$(request.auth.uid)).data.status == 'approved' &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.performance == resource.data.performance &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'caption', 'tags', 'updatedAt', 'videoUrl', 'thumbnailUrl', 'description', 'facebookPostUrl', 'productIds', 'productNames',
          'cloudinaryPublicId', 'secureUrl', 'resourceType', 'duration', 'width', 'height', 'videoMetadata'
        ])
      );

      allow delete: if isAdmin() || (
        request.auth != null &&
        resource.data.creatorUserId == request.auth.uid &&
        resource.data.status in ['pending', 'rejected']
      );
    }

    match /reel_metric_audits/{auditId} {
      allow read, write: if isAdmin();
    }

    // ====================================================
    // CRM, SUPPORT & REVIEWS
    // ====================================================
    match /chat_leads/{leadId} {
      allow create: if true;
      allow read, update, delete: if isAdmin() || isCustomerSupport();
    }

    match /support_tickets/{ticketId} {
      allow create: if true;
      allow read: if isStaff() || (request.auth != null && resource.data.customerEmail == request.auth.token.email);
      allow update, delete: if isStaff();
    }

    match /product_reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    // ====================================================
    // MARKETING, AI & SYSTEM SETTINGS
    // ====================================================
    match /ad_performance/{perfId} {
      allow read, write: if isAdmin();
    }

    match /agent_runs/{runId} {
      allow read, write: if isAdmin();
    }

    match /ai_agent_runs/{runId} {
      allow read, write: if isAdmin();
    }

    match /site_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /slack_users/{slackUserId} {
      allow read, write: if isSuperAdmin();
    }

    match /slack_error_logs/{logId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow create: if isStaff() || true;
      allow read, update, delete: if isAdmin();
    }
  }
}
