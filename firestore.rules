rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper to check if user has a staff role
    function isStaff() {
      return request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'inventory_manager', 'customer_support', 'super_admin'];
    }

    // pos_sessions and subcollection scans
    match /pos_sessions/{sessionId} {
      allow read, write: if true;
      
      match /scans/{scanId} {
        allow read, write: if true;
      }
    }

    // Standard rules for other collections
    match /users/{userId} {
      allow read, write: if true;
    }

    match /orders/{orderId} {
      allow read, write: if true;
    }

    match /products/{productId} {
      allow read, write: if true;
    }

    match /inventory_logs/{logId} {
      allow read, write: if true;
    }
    
    match /ad_performance/{perfId} {
      allow read, write: if true;
    }

    match /agent_runs/{runId} {
      allow read, write: if true;
    }

    match /ai_agent_runs/{runId} {
      allow read, write: if true;
    }

    match /site_settings/{settingId} {
      allow read, write: if true;
    }

    match /draft_orders/{draftId} {
      allow read, write: if true;
    }

    match /chat_leads/{leadId} {
      allow read, write: if true;
    }

    match /cloudinary_images/{imageId} {
      allow read, write: if true;
    }

    match /stock_movements/{movementId} {
      allow read, write: if true;
    }

    match /product_reviews/{reviewId} {
      allow read, write: if true;
    }
  }
}
